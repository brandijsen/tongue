# =============================================================================
# Tongue — web/  |  copy to .env.local  |  do not commit .env.local
# All NEXT_PUBLIC_* keys read by the app. No real secrets; URLs only.
# =============================================================================

# Base URL of the Express API (no trailing slash). Must match CORS and server PORT.
# Client calls: e.g. POST {NEXT_PUBLIC_API_URL}/api/chat
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional. Public site URL (no trailing slash) for Open Graph, Twitter, metadataBase in production.
# If unset in dev, the app falls back to http://localhost:3000 in sitePublicUrl.ts
NEXT_PUBLIC_SITE_URL=

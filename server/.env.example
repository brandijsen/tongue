# Server
PORT=4000
# Origini consentite (virgola). In dev spesso: http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL — es. Supabase)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# News — cascata PS2 (provider senza chiave vengono saltati; vedi traccia)
# (opz.) NEWS_PROVIDER_ORDER=newsdata,thenewsapi,gnews
# (opz.) NEWS_TARGET_RELEVANT_ARTICLES=4
# (opz.) MAX_ARTICLES_FOR_PROMPT=8
# (opz.) NEWS_SELECTOR_POOL_MAX=48
# (opz.) USE_MOCK_NEWS=false
# Log strutturati ricerca/selezione notizie in console ([news trace]). Disattiva: NEWS_TRACE=0
# (opz.) NEWS_TRACE=0
# NEWSDATA_API_KEY=
# THENEWS_API_KEY=
# GNEWS_API_KEY=

# OpenAI — selettore PF8 (articoli inerenti); sintesi in passo successivo
# Senza chiave il selettore è disattivato (si usa tutto il pool fino ai cap numerici).
# OPENAI_API_KEY=
# (opz.) OPENAI_MODEL=gpt-4o-mini

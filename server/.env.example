# =============================================================================
# Tongue — server/  |  copy to .env  |  do not commit .env
# All keys used by the app; values are placeholders. No real secrets in this file.
# =============================================================================

# --- HTTP ---
PORT=4000
# Comma-separated allowed browser origins. Dev: if unset, defaults to localhost:3000 and 127.0.0.1:3000. Production: required.
CORS_ORIGIN=http://localhost:3000

# --- Database (Prisma) ---
# Pooled / runtime. Local dev: often same as DIRECT_URL. Supabase: use pooler URL; see root README.
DATABASE_URL=postgresql://USER:PASSWORD@host:5432/postgres
# Direct to Postgres for: prisma migrate, introspection. Local: same as DATABASE_URL. Supabase: "direct" connection.
DIRECT_URL=postgresql://USER:PASSWORD@host:5432/postgres

# --- OpenAI (LLM relevance filter + news summarization) ---
# If empty, selector uses full pool (up to caps); chat summarization uses fallback messages in chatRoute
OPENAI_API_KEY=
# Optional. Default in code: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# --- News APIs (cascade) — empty key skips that provider; order set by NEWS_PROVIDER_ORDER ---
NEWSDATA_API_KEY=
THENEWS_API_KEY=
GNEWS_API_KEY=
# Comma list: newsdata, thenewsapi, gnews (must match id). Default in code if unset: see server/src/news/constants.ts
NEWS_PROVIDER_ORDER=newsdata,thenewsapi,gnews
# Numeric thresholds; defaults match server/src/news/constants.ts if you omit or leave invalid
NEWS_TARGET_RELEVANT_ARTICLES=4
MAX_ARTICLES_FOR_PROMPT=8
NEWS_SELECTOR_POOL_MAX=48
# true = mock JSON fixtures, no real provider HTTP
USE_MOCK_NEWS=false
# Set to 0, false, no, or off to disable [news trace] lines in the server console. Empty = trace on.
NEWS_TRACE=

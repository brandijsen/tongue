# Server
PORT=4000
# Comma-separated allowed origins (e.g. http://localhost:3000,https://your-app.vercel.app)
CORS_ORIGIN=http://localhost:3000

# Database (Supabase PostgreSQL)
# Prefer "Session pooler" URI (Connect → Session pooler) if direct db.* host gives P1001 on your network.
# Optional: ?sslmode=require if the client requires it.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# OpenAI
OPENAI_API_KEY=
# Optional override (default e.g. gpt-4o-mini in application code)
# OPENAI_MODEL=gpt-4o-mini

# News providers (omit keys to skip a provider in the cascade)
NEWSDATA_API_KEY=
THENEWSAPI_KEY=
WORLDNEWS_API_KEY=
# Comma-separated provider ids matching code (e.g. newsdata,thenewsapi,worldnewsapi)
NEWS_PROVIDER_ORDER=newsdata,thenewsapi,worldnewsapi
MIN_ARTICLES_BEFORE_NEXT_PROVIDER=4
MAX_ARTICLES_FOR_PROMPT=8

# Development: use fixture articles instead of HTTP providers (no API keys required)
# USE_MOCK_NEWS=true

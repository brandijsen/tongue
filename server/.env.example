# Server
PORT=4000
# Comma-separated allowed origins (e.g. http://localhost:3000,https://your-app.vercel.app)
CORS_ORIGIN=http://localhost:3000

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Optional: direct connection URL if using PgBouncer pooler (Prisma migrations)
# DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# OpenAI
OPENAI_API_KEY=
# Optional override (default e.g. gpt-4o-mini in application code)
# OPENAI_MODEL=gpt-4o-mini

# News providers (omit keys to skip a provider in the cascade)
NEWSDATA_API_KEY=
THENEWSAPI_KEY=
WORLDNEWS_API_KEY=
# Comma-separated provider ids matching code (e.g. newsdata,thenewsapi,worldnewsapi)
NEWS_PROVIDER_ORDER=newsdata,thenewsapi,worldnewsapi
MIN_ARTICLES_BEFORE_NEXT_PROVIDER=4
MAX_ARTICLES_FOR_PROMPT=8

# Optional: skip real news APIs in development (implement in news service)
# USE_MOCK_NEWS=false
